# DocuForge website — environment placeholders
#
# On Lovable these variables are provisioned automatically and must not be
# edited by hand — this file exists for self-hosting reference only.
# NEVER put real secrets in frontend (VITE_*) variables.

# Browser-visible (publishable/anon keys are safe to expose)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_placeholder
VITE_SUPABASE_PROJECT_ID=your-project-ref

# Server-only (never expose to the browser, never commit real values)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_placeholder
SUPABASE_SERVICE_ROLE_KEY=service_role_placeholder
SUPABASE_PROJECT_ID=your-project-ref
